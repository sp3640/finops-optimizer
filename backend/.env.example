# FinOps Optimizer — Environment Variables
# Copy karo: cp .env.example .env
# Phir apni values bharo

# AWS
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Azure
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id
AZURE_SUBSCRIPTION_ID=your_subscription_id

# GitHub (Step 3 mein use hoga)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your-username/infrastructure
GITHUB_BASE_BRANCH=main

# Slack (weekly digest ke liye)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Thresholds
IDLE_CPU_THRESHOLD_PCT=5
IDLE_OBSERVATION_DAYS=14
RDS_CONNECTION_THRESHOLD=1